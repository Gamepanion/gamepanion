# Copy to .env next to compose.yaml and fill it in; compose.yaml reads it. Everything is optional unless noted; empty means the
# default. A commented-out line keeps the image's own default.

# Required in production: the address players and Claude reach Gamepanion at. Sign-in, the OAuth issuer and the MCP resource are built
# from it. In development it defaults to http://localhost:3000.
PUBLIC_URL=https://gamepanion.example.com

# Where gamepanion.sqlite (the log), auth.sqlite (sign-in) and the generated secret live. Default /data (the image's volume).
# DATA_DIR=/data

# Signs session cookies and encrypts the token signing keys: at least 32 bytes (openssl rand -hex 32). Unset: generated once into
# ${DATA_DIR}/secret. Changing it signs out every browser and every connected Claude.
GAMEPANION_SECRET=

# Who may become a player, comma-separated: addresses, @domain or *. Empty: nobody new (players who exist keep signing in).
GAMEPANION_SIGNUP_ALLOW=you@example.com

# Sign-in with an emailed code: an SMTP server (smtp:// or smtps://user:password@host:port) and the sender address.
GAMEPANION_SMTP_URL=
GAMEPANION_SMTP_FROM=

# Sign-in through an OpenID Connect provider. <NAME> is yours to choose (letters and digits); add a block per provider. Register
# ${PUBLIC_URL}/api/auth/callback/<name in lower case> as the redirect URI.
# Uncomment the block to use it; an issuer without a client id stops Gamepanion from starting.
# GAMEPANION_OIDC_AUTHENTIK_ISSUER=https://authentik.example.com/application/o/gamepanion/
# GAMEPANION_OIDC_AUTHENTIK_CLIENT_ID=
# GAMEPANION_OIDC_AUTHENTIK_CLIENT_SECRET=
# The button's text: "Continue with <LABEL>". Default: the name.
# GAMEPANION_OIDC_AUTHENTIK_LABEL=authentik

# The chat in the web app (ADR 0013): a Claude API key turns it on. The model, and how many messages a player may send a day.
GAMEPANION_ANTHROPIC_API_KEY=
# GAMEPANION_ANTHROPIC_MODEL=claude-opus-5-5
# Players' own Anthropic keys for the chat, stored encrypted with this key (ADR 0021): 32 bytes as hex, `openssl rand -hex 32`. Unset: players
# can't store a key. Keep it: a new one makes every stored key unreadable, and players paste theirs again.
GAMEPANION_KEY_ENCRYPTION_KEY=
# GAMEPANION_CHAT_DAILY_LIMIT=100

# Speaking into the chat: a Whisper server with the OpenAI-compatible /v1/audio/transcriptions (such as speaches), and its model.
# GAMEPANION_TRANSCRIBE_URL=http://whisper:8000
# GAMEPANION_TRANSCRIBE_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# The operator's pages (ADR 0023): Markdown files of your own, linked in the footer only when set. {lang} is replaced by the page's
# language (en, de), falling back to en. Gamepanion ships none of the texts.
# GAMEPANION_IMPRINT_FILE=/legal/imprint.{lang}.md
# GAMEPANION_PRIVACY_FILE=/legal/privacy.{lang}.md
# GAMEPANION_TERMS_FILE=/legal/terms.{lang}.md

# Payments, only for an operator who sells subscriptions (ADR 0023). Empty: every feature for everyone, no limits, nothing sold.
# GAMEPANION_PAYMENT_PROVIDER=creem
# GAMEPANION_CREEM_API_KEY=
# GAMEPANION_CREEM_PRODUCT_ID=
# GAMEPANION_CREEM_YEARLY_PRODUCT_ID=
# GAMEPANION_CREEM_WEBHOOK_SECRET=
# The pricing page's words, as the other operator pages; with creem, all four files are required.
# GAMEPANION_PRICING_FILE=/legal/pricing.{lang}.md
# Never limited: addresses, @domain entries or *, as GAMEPANION_SIGNUP_ALLOW.
# GAMEPANION_FREE_PLAYERS=
# For trying the flow without charging anyone: GAMEPANION_PAYMENT_PROVIDER=fake and a secret its webhooks are signed with.
# GAMEPANION_FAKE_WEBHOOK_SECRET=

# error, warn, info (default), debug or silent.
GAMEPANION_LOG_LEVEL=info

# The port the server listens on inside the container. Default 3000.
# PORT=3000

# "Today" (the default day of a session) is computed in this time zone.
TZ=Europe/Berlin
